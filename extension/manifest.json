{
  "manifest_version": 3,
  "name": "时效 Lite 快速提醒",
  "version": "1.0.0",
  "description": "一键把网页内容/随手文字添加为效期提醒，到点 Bark 推送到手机。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "时效 Lite 快速提醒",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-quick-remind": {
      "description": "打开快速提醒",
      "suggested_key": { "default": "Ctrl+Shift+U", "mac": "MacCtrl+Shift+U" }
    }
  },
  "permissions": ["storage", "activeTab", "contextMenus"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

# 时效 Lite 部署配置模板
# 用法：cp .env.example .env 后填真实值；.env 已被 .gitignore 排除，绝不入库

# Web 服务端口（宿主机侧）
RL_PORT=15809

# 首次启动创建的管理员账号（建好后改密码不影响）
RL_USERNAME=admin
RL_PASSWORD=changeme

# 手机上点击推送通知跳转的地址（填手机能访问到的本服务地址）
RL_BASE_URL=http://<NAS_IP>:15809

# Bark/MagicPush 推送服务器（仅缺省参考，实际通道在 Web 设置页配置）
RL_BARK_SERVER=http://<NAS_IP>:818
